{
  "name": "@tiledb-inc/viz-components",
  "version": "0.0.1",
  "description": "A base template for building a shareable web components library with Vite + Svelte",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "types": "./lib/index.d.ts",
    "import": "./lib/index.js"
  },
  "scripts": {
    "build": "vite build",
    "build:types": "yarn g:tsc --declaration --allowJs false --emitDeclarationOnly",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@tiledb-inc/viz-common": "0.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tsconfig/svelte": "5.0.5",
    "esbuild": "^0.25.10",
    "svelte": "5.39.11",
    "svelte-check": "^4.3.3",
    "svelte-preprocess": "6.0.3",
    "tslib": "^2.8.1"
  }
}
