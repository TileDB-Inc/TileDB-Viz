{
  "name": "@tiledb-inc/viz",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/common",
    "packages/components",
    "packages/core",
    "packages/react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TileDB-Inc/TileDB-Viz.git"
  },
  "author": {
    "name": "TileDB",
    "email": "support@tiledb.com"
  },
  "scripts": {
    "test": "npm run test -w packages/core",
    "build": "npm run build -w packages/common && npm run build -w packages/components && npm run build -w packages/core && npm run build -w packages/react",
    "build:common": "npm run build -w packages/common",
    "build:components": "npm run build -w packages/components",
    "build:core": "npm run build -w packages/core",
    "build:react": "npm run build -w packages/react",
    "g:tsc": "cd $INIT_CWD && tsc",
    "typedoc": "typedoc --plugin typedoc-plugin-markdown --tsconfig ./tsconfig.json",
    "quarto": "quarto render ./quarto/ --fail-if-warnings",
    "g:eslint": "cd $INIT_CWD && eslint",
    "g:parcel": "cd $INIT_CWD && parcel",
    "storybook": "npm run storybook -w packages/react",
    "lint": "yarn workspace @tiledb-inc/viz-core lint && yarn workspace @tiledb-inc/viz-react lint",
    "lint:fix": "yarn workspace @tiledb-inc/viz-common lint:fix && yarn workspace @tiledb-inc/viz-core lint:fix && yarn workspace @tiledb-inc/viz-react lint:fix"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.0",
    "eslint": "9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "7.1.10",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@tiledb-inc/tiledb-cloud": "github:TileDB-Inc/TileDB-Cloud-JS#xan/bundle-fix"
  }
}
